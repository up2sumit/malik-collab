# Public site URL. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Form delivery via Resend (https://resend.com). All three are required in production.
# Without them, the forms return a clear "not accepting submissions" error. They never fake success.
RESEND_API_KEY=
SUBMISSIONS_TO_EMAIL=you@your-domain.example
# Must be an address on a domain you have verified in Resend.
SUBMISSIONS_FROM_EMAIL=forms@your-domain.example

# Sample testimonials and sample showcase tiles are hidden in production by default.
# Set to "true" only on preview deployments while you are reviewing the design.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false

# Development only: writes submissions to .data/submissions.jsonl when no email provider is set.
# Never set this in production.
ALLOW_LOCAL_SUBMISSION_SINK=false
